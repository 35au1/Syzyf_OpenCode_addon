{
  "compilerOptions": {
    "target": "esnext",
    // dom is needed for BodyInit, referenced by the generated SDK client.
    "lib": ["esnext", "dom"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true,
    // import.meta.main is a Bun global.
    "types": ["bun"]
  },
  "include": ["dod-loop.ts"]
}
